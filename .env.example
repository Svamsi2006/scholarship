# ── Model Configuration ──────────────────────────────────────────────
# Preferred: Google AI Studio (API Key) or Vertex AI (Service Account)
LLM_FAST=gemini/gemini-2.5-flash
LLM_SMART=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=vertex_ai/gemini-2.5-flash

# If using Google AI Studio
# GEMINI_API_KEY=your_gemini_api_key

# If using Vertex AI (Service Account)
GOOGLE_APPLICATION_CREDENTIALS=service_account.json
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=us-central1

# ── Rate Limiting & Concurrency ───────────────────────────────────────
LLM_RPM=60
LLM_CONCURRENCY=6
TIME_BUDGET_S=360

# ── Tools & Enrichment ──────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key
GITHUB_TOKEN=your_github_token_optional

# ── Feature Flags ───────────────────────────────────────────────────
CACHE=1
CHAOS_RATE=0.0
AGGREGATOR_POLICY=drop
TOOLS_VIA_MCP=false
